# Copie para .env.local e preencha (não commite o .env.local).
# No Vercel: mesma variável em Production (site público) — não só Preview.
VITE_VAPID_PUBLIC_KEY=

# Stripe — opcional se usar checkout dinâmico via Edge Function
# Deixe vazio para usar create-checkout-session automaticamente
# Ou coloque um Payment Link direto: https://buy.stripe.com/...
VITE_CHECKOUT_URL=

# URL publica do app usada em links de autenticacao (ex.: reset de senha)
VITE_PUBLIC_APP_URL=https://app.easystudio.com.br

# Nome da Edge Function usada para sincronizar acesso por e-mail apos login/signup
VITE_STRIPE_SYNC_FUNCTION=sync-stripe-access

# Opcional: sobrescrever a URL das Edge Functions (autodetectada pelo Supabase URL)
# VITE_SUPABASE_FUNCTIONS_URL=https://mbxfswxjrdikdyzpukmw.functions.supabase.co
